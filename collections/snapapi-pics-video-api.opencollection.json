{
  "opencollection": "1.0.0",
  "info": {
    "name": "SnapAPI - Screenshot & Web Data Analyze Video API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Video",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Record Video",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.snapapi.pics/v1/video",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Record a video of a webpage with optional scrolling. Supports WebM, MP4, and GIF output. Costs 5 credits per recording."
        }
      ]
    }
  ],
  "bundled": true
}