              "raw": "{\n  \"url\": \"<uri>\",\n  \"type\": \"text\",\n  \"pages\": 1,\n  \"waitMs\": 0,\n  \"proxy\": \"<string>\",\n  \"premiumProxy\": \"<boolean>\",\n  \"blockResources\": false,\n  \"locale\": \"<string>\"\n}",
