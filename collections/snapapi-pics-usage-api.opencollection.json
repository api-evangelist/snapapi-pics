{
  "opencollection": "1.0.0",
  "info": {
    "name": "SnapAPI - Screenshot & Web Data Analyze Usage API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.snapapi.pics/v1/usage"
          },
          "docs": "Check your current API usage and remaining quota."
        }
      ]
    }
  ],
  "bundled": true
}